--- a/managed_components/espressif__esp_hosted/host/port/esp/freertos/src/os_wrapper.c
+++ b/managed_components/espressif__esp_hosted/host/port/esp/freertos/src/os_wrapper.c
@@ -756,7 +756,14 @@
 		void* event_data, size_t event_data_size, uint32_t ticks_to_wait)
 {
 	ESP_LOGV(TAG, "event %ld recvd --> event_data:%p event_data_size: %u\n",event_id, event_data, event_data_size);
-	return esp_event_post(WIFI_EVENT, event_id, event_data, event_data_size, ticks_to_wait);
+	/* The board's C6 firmware repeats STA_START while connecting. Forward
+	 * lifecycle transitions once; lwIP adds its interface on each START. */
+	static bool station_started;
+	if (event_id == WIFI_EVENT_STA_START && station_started) return ESP_OK;
+	int result = esp_event_post(WIFI_EVENT, event_id, event_data, event_data_size, ticks_to_wait);
+	if (result == ESP_OK && event_id == WIFI_EVENT_STA_START) station_started = true;
+	if (result == ESP_OK && event_id == WIFI_EVENT_STA_STOP) station_started = false;
+	return result;
 }
 
